# SmartButler 默认环境变量示例
# 复制为 .env 后取消注释并填入真实值

# ===== LLM 子模块 =====
# SMARTBUTLER_LLM_PROVIDER=openai
# SMARTBUTLER_LLM_BACKEND=http    # http (自建 httpx 直调) 或 langchain (包装 ChatOpenAI)
# SMARTBUTLER_LLM_MODEL=gpt-4o-mini
# SMARTBUTLER_LLM_TEMPERATURE=0.7
# SMARTBUTLER_LLM_MAX_TOKENS=4096
# SMARTBUTLER_LLM_OPENAI_API_KEY=
# SMARTBUTLER_LLM_OPENAI_BASE_URL=
# SMARTBUTLER_LLM_ANTHROPIC_API_KEY=
# SMARTBUTLER_LLM_OLLAMA_BASE_URL=

# ===== 存储子模块 =====
# SMARTBUTLER_STORAGE_SQLITE_PATH=./data/smartbutler.db
# SMARTBUTLER_STORAGE_QDRANT_URL=
# SMARTBUTLER_STORAGE_QDRANT_API_KEY=
# SMARTBUTLER_STORAGE_QDRANT_COLLECTION=smartbutler_memory
# SMARTBUTLER_STORAGE_REDIS_URL=

# ===== 日志子模块 =====
# SMARTBUTLER_LOGGING_LEVEL=INFO
# SMARTBUTLER_LOGGING_JSON_OUTPUT=false
# SMARTBUTLER_LOGGING_LOG_FILE=./logs/smartbutler.log

# ===== Agent 子模块 =====
# SMARTBUTLER_AGENT_DEFAULT_TIMEOUT=60
# SMARTBUTLER_AGENT_DEFAULT_MAX_RETRIES=3
# SMARTBUTLER_AGENT_MAX_CONCURRENT_AGENTS=8
# SMARTBUTLER_AGENT_AUTO_DISCOVER=true

# ===== Skill 子模块 (Phase 5+) =====
# SMARTBUTLER_SKILL_WORKSPACE_DIR=./workspace
# 留空默认 ./smartbutler/skills/builtin/
# SMARTBUTLER_SKILL_BUILTIN_SKILLS_DIR=
# 用户级 skill 目录(默认 ~/.smartbutler/skills/,不存在则静默跳过;留空关闭)
# SMARTBUTLER_SKILL_USER_SKILLS_DIR=

# ===== Embedding 子模块 (Phase 6.2 P0) =====
# Embedder 实现:qwen(走 Qwen Embedding API,生产) / stub(本地 hash,降级/CI/无 key)
# SMARTBUTLER_EMBEDDING_PROVIDER=qwen
# Qwen(OpenAI 兼容)API Key。**不配时工厂自动降级到 StubEmbedder**,管家不崩。
# SMARTBUTLER_EMBEDDING_API_KEY=
# Qwen Embedding 端点(OpenAI 兼容协议)
# SMARTBUTLER_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 模型名。qwen3.7-text-embedding-flash 默认 1024 维(MTEB 68.36)
# SMARTBUTLER_EMBEDDING_MODEL=qwen3.7-text-embedding-flash
# 向量维度。**必须与 SMARTBUTLER_STORAGE_QDRANT_VECTOR_SIZE 一致**(默认 1024)
# SMARTBUTLER_EMBEDDING_DIMENSION=1024
# SMARTBUTLER_EMBEDDING_TIMEOUT=30
# SMARTBUTLER_EMBEDDING_MAX_RETRIES=2
