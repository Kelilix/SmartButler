# SmartButler 默认环境变量示例
# 复制为 .env 后取消注释并填入真实值

# ===== LLM 子模块 =====
# SMARTBUTLER_LLM_PROVIDER=openai
# SMARTBUTLER_LLM_MODEL=gpt-4o-mini
# SMARTBUTLER_LLM_TEMPERATURE=0.7
# SMARTBUTLER_LLM_MAX_TOKENS=4096
# SMARTBUTLER_LLM_OPENAI_API_KEY=
# SMARTBUTLER_LLM_OPENAI_BASE_URL=
# SMARTBUTLER_LLM_ANTHROPIC_API_KEY=
# SMARTBUTLER_LLM_OLLAMA_BASE_URL=

# ===== 存储子模块 =====
# SMARTBUTLER_STORAGE_SQLITE_PATH=./data/smartbutler.db
# SMARTBUTLER_STORAGE_QDRANT_URL=
# SMARTBUTLER_STORAGE_QDRANT_API_KEY=
# SMARTBUTLER_STORAGE_QDRANT_COLLECTION=smartbutler_memory
# SMARTBUTLER_STORAGE_REDIS_URL=

# ===== 日志子模块 =====
# SMARTBUTLER_LOGGING_LEVEL=INFO
# SMARTBUTLER_LOGGING_JSON_OUTPUT=false
# SMARTBUTLER_LOGGING_LOG_FILE=./logs/smartbutler.log

# ===== Agent 子模块 =====
# SMARTBUTLER_AGENT_DEFAULT_TIMEOUT=60
# SMARTBUTLER_AGENT_DEFAULT_MAX_RETRIES=3
# SMARTBUTLER_AGENT_MAX_CONCURRENT_AGENTS=8
# SMARTBUTLER_AGENT_AUTO_DISCOVER=true
