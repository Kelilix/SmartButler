# SmartButler 默认环境变量示例
# 复制为 .env 后取消注释并填入真实值

# ===== LLM 子模块 =====
# SMARTBUTLER_LLM_PROVIDER=openai
# SMARTBUTLER_LLM_BACKEND=http    # http (自建 httpx 直调) 或 langchain (包装 ChatOpenAI)
# SMARTBUTLER_LLM_MODEL=gpt-4o-mini
# SMARTBUTLER_LLM_TEMPERATURE=0.7
# SMARTBUTLER_LLM_MAX_TOKENS=4096
# SMARTBUTLER_LLM_OPENAI_API_KEY=
# SMARTBUTLER_LLM_OPENAI_BASE_URL=
# SMARTBUTLER_LLM_ANTHROPIC_API_KEY=
# SMARTBUTLER_LLM_OLLAMA_BASE_URL=

# ===== 存储子模块 =====
# SMARTBUTLER_STORAGE_SQLITE_PATH=./data/smartbutler.db
# SMARTBUTLER_STORAGE_QDRANT_URL=
# SMARTBUTLER_STORAGE_QDRANT_API_KEY=
# SMARTBUTLER_STORAGE_QDRANT_COLLECTION=smartbutler_memory
# SMARTBUTLER_STORAGE_REDIS_URL=

# ===== 日志子模块 =====
# SMARTBUTLER_LOGGING_LEVEL=INFO
# SMARTBUTLER_LOGGING_JSON_OUTPUT=false
# SMARTBUTLER_LOGGING_LOG_FILE=./logs/smartbutler.log

# ===== Agent 子模块 =====
# SMARTBUTLER_AGENT_DEFAULT_TIMEOUT=60
# SMARTBUTLER_AGENT_DEFAULT_MAX_RETRIES=3
# SMARTBUTLER_AGENT_MAX_CONCURRENT_AGENTS=8
# SMARTBUTLER_AGENT_AUTO_DISCOVER=true

# ===== Skill 子模块 (Phase 5+) =====
# SMARTBUTLER_SKILL_WORKSPACE_DIR=./workspace
# 留空默认 ./smartbutler/skills/builtin/
# SMARTBUTLER_SKILL_BUILTIN_SKILLS_DIR=
# 用户级 skill 目录(默认 ~/.smartbutler/skills/,不存在则静默跳过;留空关闭)
# SMARTBUTLER_SKILL_USER_SKILLS_DIR=

# ===== Embedding 子模块 (Phase 6.2 P0) =====
# Embedder 实现:qwen(走 Qwen Embedding API,生产) / stub(本地 hash,降级/CI/无 key)
# SMARTBUTLER_EMBEDDING_PROVIDER=qwen
# Qwen(OpenAI 兼容)API Key。**不配时工厂自动降级到 StubEmbedder**,管家不崩。
# SMARTBUTLER_EMBEDDING_API_KEY=
# Qwen Embedding 端点(OpenAI 兼容协议)
# SMARTBUTLER_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 模型名。qwen3.7-text-embedding-flash 默认 1024 维(MTEB 68.36)
# SMARTBUTLER_EMBEDDING_MODEL=qwen3.7-text-embedding-flash
# 向量维度。**必须与 SMARTBUTLER_STORAGE_QDRANT_VECTOR_SIZE 一致**(默认 1024)
# SMARTBUTLER_EMBEDDING_DIMENSION=1024
# SMARTBUTLER_EMBEDDING_TIMEOUT=30
# SMARTBUTLER_EMBEDDING_MAX_RETRIES=2

# ===== Memory 子模块 (Phase 6.4 P2) =====
# 注入 prompt 的"已完成 task 摘要"条数(包含 abandoned,不含 chitchat_done)
# 用户决策 2026-10-11:完成态不能丢,得给 LLM 看"之前做过啥"
# SMARTBUTLER_MEMORY_N_COMPLETED_TASKS=3
# 注入 prompt 的"最近闲聊 task 摘要"条数
# 用户决策 2026-10-11:闲聊也有关系/语气价值,保留固定条数
# SMARTBUTLER_MEMORY_N_CHITCHAT_TASKS=30
# 跨 task 锚点(paused/未完成)摘要条数
# SMARTBUTLER_MEMORY_N_PRIOR_TASKS=3
# TaskScheduler 周期扫描间隔(秒) — 默认 1h,生产可调长,dev 可调短
# SMARTBUTLER_MEMORY_JUDGE_INTERVAL_SECONDS=3600
# 每轮 user 消息是否触发一次 judge(有频率限制),True 可降低完成态判定延迟
# 担心 token 消耗可设 False(回退到 1h 周期)
# SMARTBUTLER_MEMORY_JUDGE_ON_MESSAGE=false
# judge 触发最小间隔(秒),防止连续消息反复触发
# SMARTBUTLER_MEMORY_JUDGE_MIN_INTERVAL_SECONDS=60
# 🆕 Phase 6.5: judge 触发后延迟 N 秒再执行(期间新消息会重置定时器)
# 0=老行为(节流);>0=debounce(保留最后一次未 judge 的消息,避免快速切话题时漏掉)
# 配合 judge_min_interval_seconds=3 + debounce=2:用户连发 3 条也只在最后 1 条后 2 秒判一次
# SMARTBUTLER_MEMORY_ON_MESSAGE_DEBOUNCE_SECONDS=0
# 🆕 Phase 6.5: paused task 超过此轮数自动 complete(避免 paused 无限堆积)
# 0=关闭自动 complete(只计数,不入土)
# SMARTBUTLER_MEMORY_PAUSED_MAX_STALENESS=5
# 🆕 Phase 6.5: 单次 judge LLM 调用超时(秒),超时降级到 fallback(走规则 boundary)
# SMARTBUTLER_MEMORY_JUDGE_TIMEOUT_SECONDS=8
# 🆕 Phase 6.5: 喂给 segmenter 的最近消息窗口大小
# 切归类只需要"最新一条"+"上一条"做对照
# SMARTBUTLER_MEMORY_JUDGE_WINDOW_SIZE=2
# recall 相似度下限(归一化 raw_norm),0=关闭
# 0.2 的实测依据:正确内容 raw_norm=0.409 保留,无关内容 0.118 丢弃
# ⚠️ 0.55(初版默认)会把正确答案一起滤掉,导致 recall 命中 0
# SMARTBUTLER_MEMORY_RECALL_MIN_SCORE=0.2
# 🆕 2026-10-12:单条 fact 注入 prompt 的字符上限,0=不截断
# 为什么默认不截断:三轮实测踩坑(200 砍掉结论 / 1000 砍掉中段年龄事实 /
# 保首尾也砍掉),根因是问答式对话信息密度不均匀(user 平均 16 字符 vs
# assistant 平均 440 字符),按字符位置截断必然砍到被长文包裹的关键短语。
# 用户决策"召回优先于 prompt 预算"—— 想控制体积时再调大此值。
# SMARTBUTLER_MEMORY_MAX_FACT_CHARS=0
# 短库 block 占总预算比例(仅在启用预算时生效,当前不截断故不参与)
# SMARTBUTLER_MEMORY_SHORT_TERM_RATIO=0.4
